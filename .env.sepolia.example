# ==============================================================================
# ASO Sentinel - Sepolia Testnet Configuration Template
# ==============================================================================
# Copy this file to .env.sepolia (which is strictly gitignored):
#   cp .env.sepolia.example .env.sepolia
#
# IMPORTANT SECURITY RULES:
# 1. NEVER use a private key associated with Ethereum Mainnet or holding real funds.
# 2. Use a dedicated, low-balance testnet burner key for the relayer.
# 3. NEVER commit .env.sepolia, keystore passwords, or private keys to git.
# 4. Values in this template must stay empty/zero.
# ==============================================================================

# Sepolia RPC URL (Alchemy / Infura / QuickNode recommended)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Relayer / Keeper address and private key (sends transactions on Sepolia)
RELAYER=0x0000000000000000000000000000000000000000
SEPOLIA_RELAYER_KEY=

# Optional: Deployer private key (leave empty if using Foundry keystore: --account <name>)
SEPOLIA_DEPLOYER_KEY=

# 5 ASO Oracle Source private keys (generated via `cast wallet new`, off-chain EIP-712 signers, need NO ETH)
SOURCE_KEY_1=
SOURCE_KEY_2=
SOURCE_KEY_3=
SOURCE_KEY_4=
SOURCE_KEY_5=

# Comma-separated list of the 5 ASO source signer addresses (strictly ascending by address)
ASO_SIGNERS=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=
